# API base is same-origin in the shipped bundle. Runtime window.NOVA_CONFIG may override it.
API_BASE=/api/v1
# Development proxy target only; never embedded in the client bundle.
API_PROXY_TARGET=http://localhost:8080
FRONTEND_PORT=4200
# Optional live-server URLs for Playwright.
E2E_BASE_URL=http://localhost:4200
E2E_BACKEND_URL=http://localhost:8080


# JDBC maintenance database; application database is separately provisioned.
DATABASE_URL=jdbc:postgresql://localhost:5432/postgres
# Dummy local database credentials.
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Unique database per deployment; tests use nova_test.
DB_NAME=nova
# Dummy local-only signing key; supply a random secret for nonlocal deployment.
JWT_SECRET=local-demonstration-only-signing-key-replace-before-deploy
JWT_SECONDS=86400
# Local frontend origin; same-origin deployment may leave CORS disabled.
CORS_ORIGINS=http://localhost:4200
PORT=8080
DEMO_DATE=2026-10-14
SEED_ON_STARTUP=true
DEPLOYMENT=local

# JDBC maintenance database; application database is separately provisioned.
DATABASE_URL=jdbc:postgresql://localhost:5432/postgres
# Supply dedicated database credentials privately.
DB_USERNAME=postgres
DB_PASSWORD=
# Unique database per deployment; tests use nova_test.
DB_NAME=nova
# Generate a random signing secret of at least 32 bytes; never commit it.
JWT_SECRET=
JWT_SECONDS=86400
# Local frontend origin; same-origin deployment may leave CORS disabled.
CORS_ORIGINS=http://localhost:4200
PORT=8080
DEMO_DATE=2026-10-14
SEED_ON_STARTUP=true
DEPLOYMENT=local
